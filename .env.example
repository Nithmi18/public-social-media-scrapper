# Edge Function secrets. Set them with `supabase secrets set --env-file .env`
# (never commit the real .env). SUPABASE_URL and the service key are provided
# by Supabase automatically.
COLLECTOR_SECRET=          # 32+ random chars; must match Vault secret 'scraper_collector_secret'
META_ACCESS_TOKEN=         # Business Manager System User token (does not expire)
META_CALLER_IG_ID=         # numeric ID of your Instagram professional account that makes the calls
META_GRAPH_VERSION=        # e.g. v24.0
YOUTUBE_API_KEY=           # Google Cloud API key with YouTube Data API v3 enabled
